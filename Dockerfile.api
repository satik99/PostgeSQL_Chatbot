FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir --default-timeout=1000 --retries 10 torch --index-url https://download.pytorch.org/whl/cpu
COPY requirements-api.txt .
RUN pip install --no-cache-dir --default-timeout=1000 --retries 10 -r requirements-api.txt
COPY api.py generate.py retrieve.py llm.py ./
EXPOSE 8000
CMD ["uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8000"]